# Agent 对话与多轮问题改写：DeepSeek（仅服务器端）
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_INACTIVITY_TIMEOUT_MS=15000
DEEPSEEK_TOTAL_TIMEOUT_MS=45000

# Production retrieval: default remains Vector-only. Server-side flags only.
RERANKER_ENABLED=false
RERANKER_TIMEOUT_MS=2500
RAG_DEBUG=false

# Embedding：BAAI/bge-small-zh-v1.5，本地 CPU 推理，无需 API Key。
# 先执行 pnpm model:prepare 与 pnpm model:verify；运行时只读取 models/ 中的固定产物。

# 单进程保护。TRUST_PROXY=false 忽略所有转发 IP，使用共享限流桶。
MAX_CONCURRENT_CHATS=2
TRUST_PROXY=false
# 仅可信入口使用：至少 32 字符随机值；入口覆盖 X-Forwarded-For（单一 IP）
# 并注入 x-proxy-token。不得发送给浏览器。还必须封锁绕过入口的直连。
PROXY_AUTH_TOKEN=

# Default fictional data; private data must remain ignored.
KNOWLEDGE_DIR=knowledge/example
